  {
    "name": "repair/truncated-interleaved-299",
    "fn": "repair_json",
    "args": {
      "text": "[{\"a\": 1}, {\"b\": 2"
    },
    "corrected": {
      "ok": true,
      "value": "[{\"a\": 1}, {\"b\": 2}]",
      "why": "Python appends every `]` then every `}`; `[` `{` needs `}]`.",
      "issue": 299
    }
  },
  {
    "name": "repair/truncated-interleaved-nested-299",
    "fn": "repair_json",
    "args": {
      "text": "{\"items\": [{\"a\": 1"
    },
    "corrected": {
      "ok": true,
      "value": "{\"items\": [{\"a\": 1}]}",
      "why": "Same defect, one level up.",
      "issue": 299
    }
  },
