  "name": "fixture/abstract_only_article.xml",
  "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!--\n  A JATS document with no <body> — the shape medRxiv serves for some\n  preprints via the `jatsxml` URL in its details API. Front matter and a\n  back-matter \"Data Availability\" section are present, but there is no\n  article body, so this document carries nothing beyond the abstract.\n-->\n<article xml:lang=\"en\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n  <front>\n    <journal-meta>\n      <journal-id journal-id-type=\"hwp\">medrxiv</journal-id>\n      <journal-title>medRxiv</journal-title>\n    </journal-meta>\n    <article-meta>\n      <article-id pub-id-type=\"doi\">10.64898/2025.12.25.25343018</article-id>\n      <title-group>\n        <article-title>Why More Doctors May Not Mean More Essential-Specialty Physicians</article-title>\n      </title-group>\n      <contrib-group>\n        <contrib contrib-type=\"author\">\n          <name>\n            <surname>Yu</surname>\n            <given-names>Hojun</given-names>\n          </name>\n        </contrib>\n      </contrib-group>\n      <pub-date>\n        <year>2026</year>\n      </pub-date>\n      <abstract>\n        <p>Korea is expanding medical school admissions on the assumption that a\n        larger physician pool will relieve shortages in essential specialties.\n        This article argues that the essential-care crisis is better understood\n        as a problem of allocation than of absolute numbers.</p>\n      </abstract>\n    </article-meta>\n  </front>\n  <back>\n    <sec>\n      <title>Data Availability</title>\n      <p>All data produced in the present work are contained in the manuscript.</p>\n    </sec>\n  </back>\n</article>\n"
 },
