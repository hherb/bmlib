      "abstract_sections": [
        {
          "content": "Cancer remains a leading cause of death worldwide. Novel therapeutic compounds are urgently needed.",
          "title": "Background"
        },
        {
          "content": "We treated three human cancer cell lines with Compound X at varying concentrations and measured apoptosis using flow cytometry.",
          "title": "Methods"
        },
        {
          "content": "Compound X induced dose-dependent apoptosis in all cell lines tested, with IC50 values ranging from 2.5 to 8.3 μM.",
          "title": "Results"
        },
        {
          "content": "Compound X shows promising anti-cancer activity and warrants further investigation in animal models.",
          "title": "Conclusions"
        }
      ],
