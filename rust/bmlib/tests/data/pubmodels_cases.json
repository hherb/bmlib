  {
    "name": "downloadday/unreadable-last-verified",
    "fn": "downloadday_roundtrip",
    "args": {
      "data": {
        "source": "s",
        "date": "d",
        "status": "completed",
        "record_count": 0,
        "downloaded_at": "2024-01-02T03:04:05+00:00",
        "last_verified_at": "nonsense"
      }
    },
    "expect_error": true,
    "corrected": {
      "ok": false,
      "error": "last_verified_at is not a readable ISO 8601 timestamp: 'nonsense'",
      "why": "Python reads this field with the lenient `_parse_datetime`, so an unreadable value raises `datetime.fromisoformat`'s own `Invalid isoformat string: 'nonsense'`, which names neither the column nor the row. This is the same defect class as #98 and #99, which the strict validators beside it were written to fix: a bulk deserialiser has nothing to report. The port names the field, as `_require_datetime` does for `downloaded_at`.",
      "issue": null
    }
