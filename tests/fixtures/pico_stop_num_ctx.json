      "expected": {"requests": 6, "error": null, "note": null,
        "progress": ["starting 0/0 level 0 items 0/1", "batching 0/4 level 0 items 0/1", "extracting 1/4 level 0 items 0/1", "extracting 2/4 level 0 items 0/1", "extracting 3/4 level 0 items 0/1", "extracting 4/4 level 0 items 0/1", "complete 0/0 level 0 items 1/1"]}
    },
