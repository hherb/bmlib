{
  "description": "Ollama's native /api/chat, non-streamed. Each request is in neutral form (what a caller passes to chat()) with the body both languages must build, without the 'stream' field Rust adds. Each response is a native body, the request's messages (Ollama's token estimate needs them) and the answer both languages must read from it. Python's OllamaProvider is the oracle.",
  "requests": [
    {
      "name": "plain-chat",
      "request": {
        "model": "llama3.2",
        "messages": [
          {"role": "system", "content": "Answer from the paper only."},
          {"role": "user", "content": "Was the trial blinded?"}
        ],
        "temperature": 0.2,
        "max_tokens": 512
      },
      "body": {
        "model": "llama3.2",
        "messages": [
          {"role": "system", "content": "Answer from the paper only."},
          {"role": "user", "content": "Was the trial blinded?"}
        ],
        "options": {"temperature": 0.2, "num_predict": 512}
      }
    },
    {
      "name": "num-ctx-and-top-p",
      "request": {
        "model": "qwen3:32b",
        "messages": [{"role": "user", "content": "Summarise the methods."}],
        "temperature": 0.7,
        "max_tokens": 4096,
        "top_p": 0.9,
        "num_ctx": 32768
      },
      "body": {
        "model": "qwen3:32b",
        "messages": [{"role": "user", "content": "Summarise the methods."}],
        "options": {"temperature": 0.7, "num_predict": 4096, "top_p": 0.9, "num_ctx": 32768}
      }
    },
    {
      "name": "json-mode",
      "request": {
        "model": "llama3.2",
        "messages": [{"role": "user", "content": "Give the PICO as JSON."}],
        "temperature": 0.1,
        "max_tokens": 1024,
        "json_mode": true
      },
      "body": {
        "model": "llama3.2",
        "messages": [{"role": "user", "content": "Give the PICO as JSON."}],
        "options": {"temperature": 0.1, "num_predict": 1024},
        "format": "json"
      }
    },
    {
      "name": "tools-and-a-tool-call-turn",
      "request": {
        "model": "llama3.2",
        "messages": [
          {"role": "user", "content": "Add 2 and 3."},
          {
            "role": "assistant",
            "content": "",
            "tool_calls": [{"id": "call_a", "name": "add", "arguments": {"a": 2, "b": 3}}]
          },
          {"role": "tool", "content": "5", "tool_call_id": "call_a"},
          {"role": "tool", "content": "no id"}
        ],
        "temperature": 0.3,
        "max_tokens": 256,
        "tools": [
          {
            "name": "add",
            "description": "Add two numbers",
            "parameters": {
              "type": "object",
              "properties": {"a": {"type": "number"}, "b": {"type": "number"}}
            }
          },
          {"name": "now", "description": "The current time", "parameters": {}}
        ]
      },
      "body": {
        "model": "llama3.2",
        "messages": [
          {"role": "user", "content": "Add 2 and 3."},
          {
            "role": "assistant",
            "content": "",
            "tool_calls": [
              {"id": "call_a", "type": "function", "function": {"name": "add", "arguments": {"a": 2, "b": 3}}}
            ]
          },
          {"role": "tool", "content": "5", "tool_call_id": "call_a"},
          {"role": "tool", "content": "no id"}
        ],
        "options": {"temperature": 0.3, "num_predict": 256},
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "add",
              "description": "Add two numbers",
              "parameters": {
                "type": "object",
                "properties": {"a": {"type": "number"}, "b": {"type": "number"}}
              }
            }
          },
          {
            "type": "function",
            "function": {
              "name": "now",
              "description": "The current time",
              "parameters": {"type": "object", "properties": {}}
            }
          }
        ]
      }
    },
    {
      "name": "think-true",
      "request": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "temperature": 0.6, "max_tokens": 64, "think": true},
      "body": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "options": {"temperature": 0.6, "num_predict": 64}, "think": true}
    },
    {
      "name": "think-false",
      "request": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "temperature": 0.6, "max_tokens": 64, "think": false},
      "body": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "options": {"temperature": 0.6, "num_predict": 64}, "think": false}
    },
    {
      "name": "think-an-effort-level",
      "request": {"model": "gpt-oss", "messages": [{"role": "user", "content": "Why?"}], "temperature": 0.6, "max_tokens": 64, "think": "high"},
      "body": {"model": "gpt-oss", "messages": [{"role": "user", "content": "Why?"}], "options": {"temperature": 0.6, "num_predict": 64}, "think": "high"}
    },
    {
      "name": "think-a-budget-is-on",
      "request": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "temperature": 0.6, "max_tokens": 64, "think": 8000},
      "body": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "options": {"temperature": 0.6, "num_predict": 64}, "think": true}
    },
    {
      "name": "think-a-zero-budget-is-off",
      "request": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "temperature": 0.6, "max_tokens": 64, "think": 0},
      "body": {"model": "qwen3", "messages": [{"role": "user", "content": "Why?"}], "options": {"temperature": 0.6, "num_predict": 64}, "think": false}
    }
  ],
  "responses": [
