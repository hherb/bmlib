{
  "description": "The one keychain item holding every provider's API key (#634), shared by bmlib/secrets.py and rust/bmlib/src/secrets.rs. `read`: the item's text and the key list it reads as, or `unreadable`. `write`: a key list and the exact text written for it (compact, keys sorted, non-ASCII kept). `bundle`: a KeyBundle over an in-memory vault holding `item` (null: no item yet); each step's `fail_write` (`fail_read`) makes that step's write (read) fail, and its `another_writer` replaces the vault's text before the step, as another process saving a key would; a get answers from the cache once the item is read, a set or delete reads it again; `expect` is a get's key (null: none), `ok`, or `error`; `item_after` is the vault's text at the end and `reads` how often it was read.",
  "read": [
    {"name": "empty object", "text": "{}", "expect": {"keys": {}}},
    {"name": "two providers", "text": "{\"anthropic\":\"sk-ant-1\",\"openai\":\"sk-2\"}", "expect": {"keys": {"anthropic": "sk-ant-1", "openai": "sk-2"}}},
    {"name": "whitespace around and inside", "text": " \n{ \"openai\" : \"sk-2\" }\t\r\n", "expect": {"keys": {"openai": "sk-2"}}},
    {"name": "escapes decode", "text": "{\"a\\u00e9\":\"q\\\"b\\\\c\\n\\u0001\"}", "expect": {"keys": {"aé": "q\"b\\c\n\u0001"}}},
    {"name": "non-ASCII kept", "text": "{\"模型\":\"ключ\"}", "expect": {"keys": {"模型": "ключ"}}},
    {"name": "an escaped surrogate pair", "text": "{\"p\":\"\\ud83d\\ude00\"}", "expect": {"keys": {"p": "😀"}}},
    {"name": "a duplicate provider: the later key wins", "text": "{\"openai\":\"old\",\"openai\":\"new\"}", "expect": {"keys": {"openai": "new"}}},
    {"name": "a duplicate provider whose first value is not a string", "text": "{\"openai\":1,\"openai\":\"sk-1\"}", "expect": {"error": "unreadable"}},
    {"name": "a duplicate provider whose later value is not a string", "text": "{\"openai\":\"sk-1\",\"openai\":null}", "expect": {"error": "unreadable"}},
    {"name": "a lone surrogate in a provider name", "text": "{\"\\udc00\":\"sk-1\"}", "expect": {"error": "unreadable"}},
    {"name": "an empty key is a key", "text": "{\"openai\":\"\"}", "expect": {"keys": {"openai": ""}}},
    {"name": "empty text", "text": "", "expect": {"error": "unreadable"}},
    {"name": "not JSON", "text": "not json sk-leaky", "expect": {"error": "unreadable"}},
    {"name": "an array", "text": "[\"sk-1\"]", "expect": {"error": "unreadable"}},
    {"name": "a bare string", "text": "\"sk-1\"", "expect": {"error": "unreadable"}},
    {"name": "null", "text": "null", "expect": {"error": "unreadable"}},
    {"name": "a number value", "text": "{\"openai\":1}", "expect": {"error": "unreadable"}},
    {"name": "a null value", "text": "{\"openai\":null}", "expect": {"error": "unreadable"}},
    {"name": "an object value", "text": "{\"openai\":{\"key\":\"sk-1\"}}", "expect": {"error": "unreadable"}},
    {"name": "NaN value", "text": "{\"openai\":NaN}", "expect": {"error": "unreadable"}},
    {"name": "a lone surrogate", "text": "{\"openai\":\"\\ud800\"}", "expect": {"error": "unreadable"}},
    {"name": "a byte-order mark", "text": "\ufeff{}", "expect": {"error": "unreadable"}},
    {"name": "a raw control character in a string", "text": "{\"openai\":\"a\u0001b\"}", "expect": {"error": "unreadable"}},
    {"name": "trailing text", "text": "{} {}", "expect": {"error": "unreadable"}},
    {"name": "a trailing comma", "text": "{\"openai\":\"sk-1\",}", "expect": {"error": "unreadable"}},
    {"name": "nested arrays in a value", "text": "{\"openai\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}", "expect": {"error": "unreadable"}}
  ],
  "write": [
    {"name": "no keys", "keys": {}, "text": "{}"},
    {"name": "keys sorted, compact", "keys": {"openai": "sk-2", "anthropic": "sk-ant-1"}, "text": "{\"anthropic\":\"sk-ant-1\",\"openai\":\"sk-2\"}"},
    {"name": "sorted by code point", "keys": {"b": "1", "B": "2", "é": "3", "z": "4"}, "text": "{\"B\":\"2\",\"b\":\"1\",\"z\":\"4\",\"é\":\"3\"}"},
    {"name": "non-ASCII written as is", "keys": {"模型": "ключ", "p": "😀"}, "text": "{\"p\":\"😀\",\"模型\":\"ключ\"}"},
    {"name": "quote, backslash, slash", "keys": {"p": "a\"b\\c/d"}, "text": "{\"p\":\"a\\\"b\\\\c/d\"}"},
    {"name": "short escapes", "keys": {"p": "\b\f\n\r\t"}, "text": "{\"p\":\"\\b\\f\\n\\r\\t\"}"},
    {"name": "other control characters as lowercase \\u escapes", "keys": {"p": "\u0000\u0001\u001f"}, "text": "{\"p\":\"\\u0000\\u0001\\u001f\"}"},
    {"name": "DEL and the line separators unescaped", "keys": {"p": "\u007f\u2028\u2029"}, "text": "{\"p\":\"\u007f\u2028\u2029\"}"}
  ],
  "bundle": [
    {
      "name": "a set reads the item again and keeps another writer's key",
      "item": "{\"a\":\"1\"}",
      "steps": [
        {"op": "get", "provider": "a", "expect": {"key": "1"}},
        {"op": "set", "provider": "c", "key": "3", "another_writer": "{\"a\":\"1\",\"b\":\"2\"}", "expect": "ok"},
        {"op": "get", "provider": "b", "expect": {"key": "2"}}
      ],
      "item_after": "{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\"}",
      "reads": 2
    },
    {
      "name": "a delete reads the item again and removes a key another writer saved",
      "item": null,
      "steps": [
        {"op": "get", "provider": "openai", "expect": {"key": null}},
        {"op": "delete", "provider": "openai", "another_writer": "{\"openai\":\"k1\"}", "expect": "ok"},
        {"op": "get", "provider": "openai", "expect": {"key": null}}
      ],
      "item_after": "{}",
      "reads": 2
    },
    {
      "name": "a first set whose write fails caches nothing it did not write",
      "item": null,
      "steps": [
        {"op": "set", "provider": "openai", "key": "k1", "fail_write": true, "expect": "error"},
        {"op": "get", "provider": "openai", "expect": {"key": null}}
      ],
      "item_after": null,
      "reads": 1
    },
    {
      "name": "a key that is the empty string is a key, and is deleted",
      "item": "{\"openai\":\"\"}",
      "steps": [
        {"op": "delete", "provider": "openai", "expect": "ok"}
      ],
      "item_after": "{}",
      "reads": 1
    },
    {
      "name": "set, get and delete",
      "item": null,
      "steps": [
        {"op": "get", "provider": "openai", "expect": {"key": null}},
        {"op": "set", "provider": "openai", "key": "k1", "expect": "ok"},
        {"op": "set", "provider": "anthropic", "key": "k2", "expect": "ok"},
        {"op": "get", "provider": "openai", "expect": {"key": "k1"}},
        {"op": "delete", "provider": "openai", "expect": "ok"},
        {"op": "get", "provider": "openai", "expect": {"key": null}},
        {"op": "get", "provider": "anthropic", "expect": {"key": "k2"}}
      ],
      "item_after": "{\"anthropic\":\"k2\"}",
      "reads": 4
    },
    {
      "name": "the item is read once however many providers are asked about",
      "item": "{\"a\":\"1\"}",
      "steps": [
        {"op": "get", "provider": "a", "expect": {"key": "1"}},
        {"op": "get", "provider": "b", "expect": {"key": null}},
        {"op": "get", "provider": "c", "expect": {"key": null}},
        {"op": "get", "provider": "a", "expect": {"key": "1"}}
      ],
      "item_after": "{\"a\":\"1\"}",
      "reads": 1
    },
    {
      "name": "a delete of an absent key writes nothing",
      "item": "{ \"a\" : \"1\" }",
      "steps": [
        {"op": "delete", "provider": "b", "fail_write": true, "expect": "ok"}
      ],
      "item_after": "{ \"a\" : \"1\" }",
      "reads": 1
    },
    {
      "name": "a failed write leaves the cache, and so later gets, unchanged",
      "item": null,
      "steps": [
        {"op": "set", "provider": "openai", "key": "k1", "expect": "ok"},
        {"op": "set", "provider": "openai", "key": "k2", "fail_write": true, "expect": "error"},
        {"op": "delete", "provider": "openai", "fail_write": true, "expect": "error"},
        {"op": "get", "provider": "openai", "expect": {"key": "k1"}}
      ],
      "item_after": "{\"openai\":\"k1\"}",
      "reads": 3
    },
    {
      "name": "an unreadable item is an error for get and delete, read again each time",
      "item": "not json sk-leaky",
      "steps": [
        {"op": "get", "provider": "openai", "expect": "error"},
        {"op": "delete", "provider": "openai", "expect": "error"},
        {"op": "get", "provider": "openai", "expect": "error"}
      ],
      "item_after": "not json sk-leaky",
      "reads": 3
    },
    {
      "name": "a failed read is not cached: the next call reads again",
      "item": "{\"openai\":\"k1\"}",
      "steps": [
        {"op": "get", "provider": "openai", "fail_read": true, "expect": "error"},
        {"op": "set", "provider": "anthropic", "key": "k2", "fail_read": true, "expect": "error"},
        {"op": "get", "provider": "openai", "expect": {"key": "k1"}},
        {"op": "get", "provider": "openai", "fail_read": true, "expect": {"key": "k1"}}
      ],
      "item_after": "{\"openai\":\"k1\"}",
      "reads": 3
    },
    {
      "name": "set over an unreadable item replaces it with just the new key",
      "item": "not json sk-leaky",
      "steps": [
        {"op": "set", "provider": "openai", "key": "k1", "expect": "ok"},
        {"op": "get", "provider": "openai", "expect": {"key": "k1"}}
      ],
      "item_after": "{\"openai\":\"k1\"}",
      "reads": 1
    },
    {
      "name": "a failed write over an unreadable item leaves it unreadable",
      "item": "[1]",
      "steps": [
        {"op": "set", "provider": "openai", "key": "k1", "fail_write": true, "expect": "error"},
        {"op": "get", "provider": "openai", "expect": "error"}
      ],
      "item_after": "[1]",
      "reads": 2
    }
  ]
}
