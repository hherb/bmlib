{
 "_readme": "Shared contract for FullTextResult.jats_xml and FullTextResult.pdf_download_failure: the service hands back the JATS it rendered, byte for byte as served, and the cache keeps it beside the HTML; a PDF tier whose download leaves no file says why (#594). bmlib's Python (tests/test_fulltext_source_contract.py) and Rust (rust/bmlib/tests/fulltext_source_contract.rs) assert against this file. Each case runs fetch_fulltext against a transport answering `responses` in order; `body_file` names a file in tests/fixtures. `jats_xml` names the body_file the result must carry exactly, or null. `seed_html` writes an HTML entry with no XML beside it before the call, as a bmlib that predates jats/ left it; `seed_unreadable_jats` then puts a directory where its XML entry belongs, which cannot be read, and `moved_aside` says that entry is under a .corrupt suffix after the call. An answer carrying `raise` fails as a transport error instead of answering. `seed_pdfs_dir_as_file` puts a file where the cache's pdfs/ directory belongs, so no PDF can be saved. `pdf_download_failure` is the cause the result must carry (absent: null) and `pdf_cached` whether it carries a `file_path` (absent: false). `then` repeats the request once the responses are spent, so it can only be answered from the cache. Expected values are hand-written, never generated by the code under test.",
 "cases": [
  {
   "name": "europepmc-fulltext-then-cache-hit",
   "request": {"pmc_id": "PMC123", "identifier": "10.1/source-a"},
   "responses": [{"status": 200, "body_file": "sample_article.xml"}],
   "expected": {"source": "europepmc", "content_kind": "fulltext", "jats_xml": "sample_article.xml"},
   "then": {"source": "cached", "content_kind": "fulltext", "jats_xml": "sample_article.xml"}
  },
  {
   "name": "ncbi-after-europepmc-404",
   "request": {"pmc_id": "PMC123"},
   "responses": [{"status": 404}, {"status": 200, "body_file": "sample_article.xml"}],
   "expected": {"source": "ncbi_pmc", "content_kind": "fulltext", "jats_xml": "sample_article.xml"}
  },
  {
   "name": "known-source-xml",
   "request": {
    "fulltext_sources": [{"url": "https://www.medrxiv.org/a.source.xml", "format": "xml", "source": "medrxiv"}]
   },
   "responses": [{"status": 200, "body_file": "sample_article.xml"}],
   "expected": {"source": "medrxiv", "content_kind": "fulltext", "jats_xml": "sample_article.xml"}
  },
  {
   "name": "abstract-carried-onto-a-pdf-link",
   "request": {
    "fulltext_sources": [
     {"url": "https://www.medrxiv.org/a.source.xml", "format": "xml", "source": "medrxiv"},
     {"url": "https://www.medrxiv.org/a.full.pdf", "format": "pdf", "source": "medrxiv"}
    ]
   },
   "responses": [{"status": 200, "body_file": "abstract_only_article.xml"}],
   "expected": {"source": "medrxiv", "content_kind": "abstract", "jats_xml": "abstract_only_article.xml"}
  },
  {
   "name": "html-entry-without-xml-is-served-without-it",
   "request": {"pmc_id": "PMC123", "identifier": "10.1/source-b"},
   "seed_html": "<h1>An entry an earlier bmlib cached</h1>",
   "responses": [],
   "expected": {"source": "cached", "content_kind": "fulltext", "jats_xml": null}
  },
  {
   "name": "unreadable-xml-beside-html-serves-the-html",
   "request": {"pmc_id": "PMC123", "identifier": "10.1/source-c"},
   "seed_html": "<h1>A readable entry</h1>",
   "seed_unreadable_jats": true,
   "responses": [],
   "expected": {"source": "cached", "content_kind": "fulltext", "jats_xml": null},
   "moved_aside": true
  },
  {
   "name": "abstract-beside-a-cached-pdf-then-cache-hit",
   "request": {
    "identifier": "10.1/source-d",
    "fulltext_sources": [
     {"url": "https://www.medrxiv.org/d.source.xml", "format": "xml", "source": "medrxiv"},
     {"url": "https://www.medrxiv.org/d.full.pdf", "format": "pdf", "source": "medrxiv"}
    ]
   },
   "responses": [{"status": 200, "body_file": "abstract_only_article.xml"}, {"status": 200, "body_file": "textless.pdf"}],
   "expected": {"source": "medrxiv", "content_kind": "abstract", "jats_xml": "abstract_only_article.xml", "pdf_cached": true},
   "then": {"source": "cached", "content_kind": "abstract", "jats_xml": "abstract_only_article.xml", "pdf_cached": true}
  },
  {
   "name": "europepmc-body-less-abstract",
   "request": {"pmc_id": "PMC123"},
   "responses": [{"status": 200, "body_file": "abstract_only_article.xml"}, {"status": 404}],
   "expected": {"source": "europepmc", "content_kind": "abstract", "jats_xml": "abstract_only_article.xml"}
  },
  {
   "name": "pdf-download-http-503",
   "request": {"identifier": "10.1/source-e", "fulltext_sources": [{"url": "https://www.biorxiv.org/e.full.pdf", "format": "pdf", "source": "biorxiv"}]},
   "responses": [{"status": 503}],
   "expected": {"source": "biorxiv", "content_kind": "none", "jats_xml": null, "pdf_download_failure": "http-503"}
  },
  {
   "name": "pdf-download-not-a-pdf",
   "request": {"identifier": "10.1/source-f", "fulltext_sources": [{"url": "https://www.biorxiv.org/f.full.pdf", "format": "pdf", "source": "biorxiv"}]},
   "responses": [{"status": 200, "body_file": "sample_article.xml"}],
   "expected": {"source": "biorxiv", "content_kind": "none", "jats_xml": null, "pdf_download_failure": "not-a-pdf"}
  },
  {
   "name": "pdf-download-request-failed",
   "request": {"identifier": "10.1/source-g", "fulltext_sources": [{"url": "https://www.biorxiv.org/g.full.pdf", "format": "pdf", "source": "biorxiv"}]},
   "responses": [{"raise": "transport"}],
   "expected": {"source": "biorxiv", "content_kind": "none", "jats_xml": null, "pdf_download_failure": "request-failed"}
  },
  {
   "name": "pdf-download-write-failed",
   "request": {"identifier": "10.1/source-h", "fulltext_sources": [{"url": "https://www.biorxiv.org/h.full.pdf", "format": "pdf", "source": "biorxiv"}]},
   "seed_pdfs_dir_as_file": true,
   "responses": [{"status": 200, "body_file": "textless.pdf"}],
   "expected": {"source": "biorxiv", "content_kind": "none", "jats_xml": null, "pdf_download_failure": "write-failed"}
  },
  {
   "name": "pdf-download-cached",
   "request": {"identifier": "10.1/source-i", "fulltext_sources": [{"url": "https://www.biorxiv.org/i.full.pdf", "format": "pdf", "source": "biorxiv"}]},
   "responses": [{"status": 200, "body_file": "textless.pdf"}],
   "expected": {"source": "biorxiv", "content_kind": "none", "jats_xml": null, "pdf_cached": true}
  }
 ]
}
