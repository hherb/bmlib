*.egg
.ruff_cache/
uv.lock
.coverage
htmlcov/
coverage.xml

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# The title sampler journals each row as it lands, so an interrupted run
# resumes rather than restarting. It is a working file; the corpus it
# produces (pdf_metadata_titles.json) is what gets committed.
tests/data/*.partial.jsonl

# Same for the JATS exhibit sampler, which journals one row per article.
# tests/data/jats_exhibits.json is the corpus that gets committed.
tests/data/*.journal.jsonl
target/

# Cargo registry cache, when CARGO_HOME points inside the workspace
# (a sandbox that permits writes only under the repository).
.cargo-home/

# The downloaded PDFium binary, when PDFIUM_BUNDLED_CACHE_DIR is pointed inside
# the workspace — which a sandbox that denies the platform default requires. It
# is a ~10 MB fetched artefact, not source, and the `pdf` feature re-fetches it.
.pdfium-cache/
